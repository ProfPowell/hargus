{
  "manifest_version": 3,
  "name": "HARgus",
  "short_name": "HARgus",
  "version": "0.1.0",
  "description": "Take a reading of any web page: what it’s built with, how it scores, and what to fix first. Saves the full HTTP conversation as HAR-PLUS.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "HARgus — take a reading",
    "default_popup": "ui/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_page": "ui/options.html",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "commands": {
    "take-reading": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Take a reading of the current tab"
    }
  }
}
