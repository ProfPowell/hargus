      "mimeType": "text/css",
      "text": "@layer reset, tokens, components;\n@layer tokens {\n  :root { --brand: oklch(62% 0.18 150); --space: clamp(1rem, 2vw, 2rem); --unused-token: 1px; }\n}\n@layer components {\n  .card {\n    container-type: inline-size;\n    padding: var(--space);\n    border: 1px solid var(--brand);\n    &.card--featured { background: color-mix(in oklch, var(--brand) 20%, white); }\n    & :is(h2, h3) { margin-block: 0; }\n  }\n  @container (width > 30rem) { .card { display: grid; gap: var(--gap-missing); } }\n  main:has(dialog[open]) { min-height: 100dvh; }\n  #legacy #ids { -webkit-border-radius: 4px; color: #f00 !important; }\n}\n@media (prefers-color-scheme: dark) { :root { --brand: oklch(72% 0.18 150); } }\n"
