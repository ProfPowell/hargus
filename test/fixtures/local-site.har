      "mimeType": "text/html",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1\">\n  <title>Terra Test Outfitters — gear for the field</title>\n  <meta name=\"description\" content=\"A local test page for HAR-PLUS with metadata, structured data, forms, images and a cross-site iframe.\">\n  <meta name=\"generator\" content=\"Eleventy v3.0.0\">\n  <link rel=\"canonical\" href=\"http://127.0.0.1/\">\n  <meta property=\"og:title\" content=\"Terra Test Outfitters\">\n  <meta name=\"twitter:card\" content=\"summary\">\n  <link rel=\"icon\" href=\"/img/favicon.svg\" type=\"image/svg+xml\">\n  <link rel=\"stylesheet\" href=\"/app.css\">\n  <script type=\"application/ld+json\">\n  {\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Terra Test Outfitters\",\"url\":\"http://127.0.0.1/\",\n   \"telephone\":\"+1-555-0100\",\"sameAs\":[\"https://www.linkedin.com/company/example\",\"https://github.com/example\"]}\n  </script>\n  <script src=\"/app.js\" defer></script>\n</head>\n<body>\n  <header><a href=\"/\">Home</a> <a href=\"/page2.html\">Page two</a> <a href=\"mailto:hello@example.com\">Email</a></header>\n  <main>\n    <h1>Gear for the field</h1>\n    <h3>Skipped a level</h3>\n    <p>Some copy about tents, stoves and a <hp-badge>custom element</hp-badge>.</p>\n    <img src=\"/img/hero.svg\" width=\"600\" height=\"200\">\n    <form action=\"/subscribe\" method=\"post\">\n      <input type=\"email\" name=\"email\" placeholder=\"Email\">\n      <button></button>\n    </form>\n    <iframe src=\"http://localhost:37091/frame.html\" width=\"300\" height=\"80\"></iframe>\n    <div style=\"height:2400px\"></div>\n    <img src=\"/img/lazy.svg\" loading=\"lazy\" alt=\"Lazy image far below the fold\" width=\"300\" height=\"100\">\n  </main>\n</body>\n</html>\n"
     },
