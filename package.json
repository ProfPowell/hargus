{
  "name": "hargus",
  "version": "0.1.0",
  "description": "HARgus: take a reading of any web page. Records the HTTP conversation (HAR) and adds screenshots, metadata, DNS/WHOIS/IP intel and pluggable audits.",
  "type": "module",
  "private": true,
  "bin": { "hargus": "cli/harplus.mjs", "harplus": "cli/harplus.mjs" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "hargus": "node cli/harplus.mjs",
    "harplus": "node cli/harplus.mjs",
    "vendor:axe": "sh scripts/vendor-axe.sh"
  },
  "engines": { "node": ">=20" }
}
